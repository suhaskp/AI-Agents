# Copy this file to ".env" and fill in real values. Never commit ".env" itself.
#
# Works with any OpenAI-compatible chat completions endpoint: OpenRouter, an
# in-house/self-hosted LLM gateway, vLLM, Ollama's OpenAI-compatible server,
# Azure OpenAI's OpenAI-compatible route, etc. The app sends a plain HTTP POST
# to AI_MODEL_ENDPOINT — it does not assume any particular vendor's SDK or URL
# conventions.

# Leave blank if your in-house endpoint doesn't require a key.
AI_MODEL_API_KEY=

# Full URL of the OpenAI-compatible chat completions endpoint.
#   OpenRouter:  https://openrouter.ai/api/v1/chat/completions
#   In-house:    https://llm.internal.yourcompany.com/v1/chat/completions
AI_MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Model identifier exactly as your endpoint expects it.
AI_MODEL_NAME=openai/gpt-4o-mini

# Optional. Caps response length if your endpoint needs it set explicitly.
# Leave blank to use the provider's default.
AI_MODEL_MAX_TOKENS=25000
